# Port HTTP de Bastion
PORT=3000

# Cookie secure (true uniquement si HTTPS). En HTTP local, laissez vide ou false.
# BASTION_COOKIE_SECURE=false

# Secret JWT — changez-le en production !
# En NODE_ENV=production, Bastion refuse de démarrer si cette valeur d'exemple
# est encore utilisée (ou si elle fait moins de 16 caractères).
JWT_SECRET=changez-moi-en-production-avec-une-longue-chaine-aleatoire

# Clé de chiffrement des mots de passe hôtes (32 octets, 64 caractères hex).
# Générer : openssl rand -hex 32
# Si absent, dérivée de JWT_SECRET (moins recommandé en production).
# BASTION_ENCRYPTION_KEY=

# Broadcast Wake-on-LAN (ex. 192.168.1.255 pour un /24)
# BASTION_WOL_BROADCAST=192.168.1.255

# Relais WoL (défaut Docker — ne pas modifier sauf cas particulier)
# WOL_RELAY_URL=http://host.docker.internal:9877
# Secret partagé bastion ↔ wol-relay (défaut : JWT_SECRET)
# WOL_RELAY_SECRET=

# CORS : origines autorisées séparées par des virgules (vide = CORS désactivé,
# suffisant pour l'usage standard où le client est servi par Bastion lui-même)
# BASTION_CORS_ORIGIN=http://192.168.1.10:3333

# Bastion est-il derrière un reverse-proxy (Traefik, Nginx...) ? Si oui, mettez
# le nombre de sauts de proxy à faire confiance (généralement 1) pour que le
# rate-limit de connexion utilise la vraie IP cliente plutôt que celle du proxy.
# Ne PAS activer si Bastion est exposé directement (le client pourrait
# falsifier X-Forwarded-For et contourner le rate-limit).
# BASTION_TRUST_PROXY=1

# SSH : vérification clé hôte (TOFU au 1er contact). false = désactivé
# BASTION_SSH_STRICT_HOST_KEY=true

# RDP : ignorer les certificats serveur (false = vérifier les certificats)
# BASTION_RDP_IGNORE_CERT=true

# Clavier RDP par défaut (si non défini sur l'hôte)
# BASTION_RDP_KEYBOARD_LAYOUT=fr-fr-azerty

# Identifiants admin par défaut (créés au premier démarrage)
BASTION_ADMIN_USER=admin
BASTION_ADMIN_PASSWORD=admin

# Sécurité RDP (séparateur |) : nla en premier si NLA activé sur Windows
# BASTION_RDP_SECURITY=nla|tls|rdp|any
GUACD_HOST=guacd
GUACD_PORT=4822

# Chemin du fichier de données JSON
DATABASE_PATH=./data/bastion.json
