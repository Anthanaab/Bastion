# Port HTTP de Bastion
PORT=3000

# Cookie secure (true uniquement si HTTPS). En HTTP local, laissez vide ou false.
# BASTION_COOKIE_SECURE=false

# Secret JWT — changez-le en production !
JWT_SECRET=changez-moi-en-production-avec-une-longue-chaine-aleatoire

# Identifiants admin par défaut (créés au premier démarrage)
BASTION_ADMIN_USER=admin
BASTION_ADMIN_PASSWORD=admin

# Sécurité RDP guacd : nla (Windows 10/11), tls, rdp, ou any
# BASTION_RDP_SECURITY=nla
GUACD_HOST=guacd
GUACD_PORT=4822

# Chemin du fichier de données JSON
DATABASE_PATH=./data/bastion.json
